# Copy this to .env and fill in the values when you are ready.
# Keep this file private. Do not commit actual credentials.

APP_NAME=agentic-workday-os
APP_MODE=setup
DEMO_MODE=true
# Optional model-backed lead reasoning. Keep the key private and uncommitted.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
USE_LANGGRAPH=true

# AWS / Bedrock
# NOTE: us.anthropic.* cross-region inference profiles are hosted in us-east-1.
# Set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY from the hackathon AWS credit account.
# AWS_PROFILE conflict with explicit keys is auto-resolved in config.py.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ENABLE_AWS=false

# Model selection.
# Use us.anthropic.* cross-region inference profile IDs (not bare anthropic.*)
# to avoid "model not found in region" errors on the hackathon account.
LEAD_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
OUTLOOK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
NTULEARN_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
VOICE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Feature toggles
ENABLE_SPEECH=false
ENABLE_OUTLOOK=false
ENABLE_NTU_LEARN=false

# Tooling
OUTLOOK_TOOL=microsoft_graph_email_query
NTULEARN_TOOL=ntulearn_fetcher
SPEECH_TOOL=speech_to_text
NTULEARN_BASE_URL=https://ntulearn.ntu.edu.sg/

# Microsoft Graph (Outlook) auth
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8501
