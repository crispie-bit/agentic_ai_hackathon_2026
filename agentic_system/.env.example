# Copy this to .env and fill in the values when you are ready.
# Keep this file private. Do not commit actual credentials.

APP_NAME=agentic-workday-os
APP_MODE=setup

# AWS / Bedrock
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ENABLE_AWS=false

# Model selection: keep the specialist models small and specific.
LEAD_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
OUTLOOK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
NTULEARN_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
VOICE_MODEL_ID=amazon.nova-micro-v1:0

# Feature toggles
ENABLE_SPEECH=false
ENABLE_OUTLOOK=false
ENABLE_NTU_LEARN=false

# Tooling
OUTLOOK_TOOL=microsoft_graph_email_query
NTULEARN_TOOL=ntulearn_fetcher
SPEECH_TOOL=speech_to_text
